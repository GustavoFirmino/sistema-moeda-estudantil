@startuml UC19 - Enviar Cupom ao Aluno por Email

skinparam sequenceArrowThickness 2
skinparam sequenceParticipant underline
skinparam sequence {
  ActorBackgroundColor #DBEAFE
  ActorBorderColor #2563EB
  ParticipantBackgroundColor #EEF2FF
  ParticipantBorderColor #4F46E5
  ArrowColor #4F46E5
  LifeLineBorderColor #A5B4FC
  LifeLineBackgroundColor #F8F9FF
  BoxBackgroundColor #F0F4FF
  BoxBorderColor #A5B4FC
  NoteBackgroundColor #FFFBEB
  NoteBorderColor #F59E0B
}
skinparam roundcorner 8

title UC19 - Enviar Cupom ao Aluno (Email)

note over TS, ES
  Este UC é incluído automaticamente em UC08 (Resgatar Vantagem).
  Disparado pelo TransacaoService após persistir a TransacaoResgate.
end note

box "Camada de Serviço" #F0F9FF
  participant "TransacaoService" as TS
  participant "EmailService" as ES
end box
collections "Servidor SMTP\n(Gmail)" as SMTP

TS -> ES : enviarCupomAluno(\n  aluno, vantagem, codigoCupom)
activate ES

ES -> ES : Monta SimpleMailMessage:\n  Para: aluno.email\n  Assunto: "Seu cupom: [vantagem.nome]"\n  Corpo: vantagem.nome,\n         empresa.nomeFantasia,\n         custo, codigoCupom

alt app.email.enabled = true
  ES -> SMTP : JavaMailSender.send(message)
  activate SMTP
  SMTP --> ES : E-mail com cupom entregue ao aluno
  deactivate SMTP
else app.email.enabled = false
  ES -> ES : Loga no console\n(modo desenvolvimento)
end

ES --> TS : OK
deactivate ES

@enduml

@startuml Comunicacao - Enviar Moedas
!pragma layout smetana
skinparam rectangle {
  BackgroundColor #EEF2FF
  BorderColor #4F46E5
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #2563EB
}
skinparam database {
  BackgroundColor #F0FFF4
  BorderColor #16A34A
}
skinparam ArrowColor #4F46E5
skinparam roundcorner 8

title Diagrama de Comunicação — Enviar Moedas (UC11)

actor "Professor" as P
rectangle ":ProfessorController" as PC
rectangle ":TransacaoService" as TS
rectangle ":ProfessorRepository" as PR
rectangle ":AlunoRepository" as AR
rectangle ":TransacaoEnvioRepository" as TER
rectangle ":EmailService" as ES
database ":PostgreSQL" as DB

P -> PC : 1: POST /professor/enviar-moedas\n(alunoId, valor, mensagem)
PC -> TS : 1.1: enviarMoedas(professorId,\nalunoId, valor, mensagem)
TS -> PR : 1.1.1: findById(professorId)\n1.1.4: save(professor saldo-valor)
TS -> AR : 1.1.2: findById(alunoId)\n1.1.5: save(aluno saldo+valor)
TS -> TS : 1.1.3: valida saldo e valor > 0
TS -> TER : 1.1.6: save(TransacaoEnvio)
TS -> ES : 1.1.7: enviarRecebimentoMoedas(aluno,\nprofessor, valor, mensagem)
PR -> DB : 2: UPDATE professores
AR -> DB : 3: UPDATE alunos
TER -> DB : 4: INSERT transacoes (ENVIO)
PC <-- TS : 1.2: TransacaoEnvio
P <-- PC : 5: "Moedas enviadas!\nAluno notificado por e-mail"

@enduml
